{
  "name": "airbnb-convertor",
  "version": "0.1.0",
  "private": true,
  "description": "Turn an authorized Airbnb host profile into structured data and a personalized hospitality website.",
  "keywords": [
    "airbnb",
    "website-generator",
    "hospitality",
    "playwright",
    "typescript",
    "static-site"
  ],
  "homepage": "https://github.com/xzaviourr/airbnb-profile-website-generator#readme",
  "bugs": {
    "url": "https://github.com/xzaviourr/airbnb-profile-website-generator/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xzaviourr/airbnb-profile-website-generator.git"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "airbnb-convertor": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "extract": "tsx src/cli.ts",
    "theme": "tsx src/theme-cli.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cheerio": "^1.1.2",
    "commander": "^14.0.0",
    "playwright": "^1.55.0",
    "slugify": "^1.6.6",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
